let currentQ = 0;
let score = 0;
let shuffled = [];
let answered = false;

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function init() {
  shuffled = shuffle(questions);
  currentQ = 0;
  score = 0;
  answered = false;
  document.getElementById('aq-score').textContent = '0';
  document.getElementById('aq-final').classList.add('aq-hidden');
  document.getElementById('aq-question-card').classList.remove('aq-hidden');
  renderQuestion();
}

function renderQuestion() {
  answered = false;
  const q = shuffled[currentQ];
  document.getElementById('aq-question').textContent = q.q[lang] || q.q.en;
  document.getElementById('aq-of-total').textContent = t.of + ' ' + shuffled.length;
  document.getElementById('aq-feedback').classList.add('aq-hidden');
  document.getElementById('aq-funfact').classList.add('aq-hidden');
  document.getElementById('aq-next').classList.add('aq-hidden');

  const progress = ((currentQ) / shuffled.length) * 100;
  document.getElementById('aq-progress').style.width = progress + '%';

  const optBox = document.getElementById('aq-options');
  optBox.innerHTML =
    '<button class="aq-opt" data-answer="ai"><span class="aq-opt-icon">🤖</span> ' + t.ai + '</button>' +
    '<button class="aq-opt" data-answer="human"><span class="aq-opt-icon">🧑</span> ' + t.human + '</button>';

  optBox.querySelectorAll('.aq-opt').forEach(function(btn) {
    btn.addEventListener('click', function() { checkAnswer(this.dataset.answer); });
  });
}

function checkAnswer(selected) {
  if (answered) return;
  answered = true;
  const q = shuffled[currentQ];
  const correct = q.a;
  const fb = document.getElementById('aq-feedback');
  const ff = document.getElementById('aq-funfact');
  fb.classList.remove('aq-hidden');
  ff.classList.remove('aq-hidden');
  ff.textContent = q.fact[lang] || q.fact.en;

  const opts = document.querySelectorAll('.aq-opt');
  opts.forEach(function(btn) {
    if (btn.dataset.answer === correct) {
      btn.classList.add('aq-opt-correct');
    } else if (btn.dataset.answer === selected && selected !== correct) {
      btn.classList.add('aq-opt-wrong');
    }
    btn.disabled = true;
  });

  if (selected === correct) {
    score++;
    document.getElementById('aq-score').textContent = score;
    fb.textContent = t.correct;
    fb.className = 'aq-feedback aq-fb-correct';
  } else {
    fb.textContent = t.wrong;
    fb.className = 'aq-feedback aq-fb-wrong';
  }

  document.getElementById('aq-next').classList.remove('aq-hidden');
}

document.getElementById('aq-next').addEventListener('click', function() {
  currentQ++;
  if (currentQ >= shuffled.length) {
    showFinal();
  } else {
    renderQuestion();
  }
});

function showFinal() {
  document.getElementById('aq-question-card').classList.add('aq-hidden');
  var fin = document.getElementById('aq-final');
  fin.classList.remove('aq-hidden');
  document.getElementById('aq-final-score').textContent = score + ' ' + t.of + ' ' + shuffled.length;
  document.getElementById('aq-progress').style.width = '100%';

  var pct = score / shuffled.length;
  var msg = t.tryHarder;
  if (pct >= 0.8) msg = t.great;
  else if (pct >= 0.5) msg = t.good;
  document.getElementById('aq-final-msg').textContent = msg;
}

init();
</script>

