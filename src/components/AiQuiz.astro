---

<section class="aq-section" id="ai-quiz">
  <div class="aq-container">
    <h2 class="aq-title">{t.title}</h2>
    <p class="aq-subtitle">{t.subtitle}</p>

    <div class="aq-score-bar">
      <span class="aq-score-label">{t.score}: <strong id="aq-score">0</strong> <span id="aq-of-total"></span></span>
      <div class="aq-progress-wrap">
        <div class="aq-progress-bar" id="aq-progress"></div>
      </div>
    </div>

    <div class="aq-question-card" id="aq-question-card">
      <p class="aq-question-text" id="aq-question"></p>
      <div class="aq-options" id="aq-options"></div>
      <div class="aq-feedback aq-hidden" id="aq-feedback"></div>
      <p class="aq-funfact aq-hidden" id="aq-funfact"></p>
      <button class="aq-btn-next aq-hidden" id="aq-next">{t.next}</button>
    </div>

    <div class="aq-final aq-hidden" id="aq-final">
      <div class="aq-final-score" id="aq-final-score"></div>
      <p class="aq-final-msg" id="aq-final-msg"></p>
      <button class="aq-btn-play" onclick="location.reload()">{t.playAgain}</button>
    </div>
  </div>
</section>

