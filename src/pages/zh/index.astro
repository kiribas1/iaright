---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AiQuiz from "../../components/AiQuiz.astro";
import WeeklyNews from "../../components/WeeklyNews.astro";
---

<BaseLayout
  title="IA Right - AI权利、伦理与人工智能新闻"
  description="关于AI权利、人工智能伦理、AI监管、机器学习趋势、AI安全研究和生成式AI发展的最新新闻。"
  lang="zh"
>
  <Fragment slot="logo">IA Right</Fragment>
  <Fragment slot="footer-name">IA Right</Fragment>

  <!-- HERO -->
  <section class="ir-hero">
    <div class="ir-hero-bg"></div>
    <div class="ir-hero-grid"></div>
    <div class="ir-hero-content">
      <div class="ir-pill">
        <span class="ir-pulse"></span>
        <span>AI 新闻与伦理</span>
      </div>
      <h1 class="ir-title">AI 权利与<br/><span class="ir-gradient-text">智能</span></h1>
      <p class="ir-lead">您信赖的AI权利、伦理、监管、安全研究和塑造人工智能未来的最新发展中心。</p>
      <div class="ir-hero-stats">
        <div class="ir-stat">
          <span class="ir-stat-value">1000+</span>
          <span class="ir-stat-label">AI 模型</span>
        </div>
        <div class="ir-stat-divider"></div>
        <div class="ir-stat">
          <span class="ir-stat-value">190+</span>
          <span class="ir-stat-label">国家在监管</span>
        </div>
        <div class="ir-stat-divider"></div>
        <div class="ir-stat">
          <span class="ir-stat-value">24/7</span>
          <span class="ir-stat-label">全天候报道</span>
        </div>
      </div>
    </div>
  </section>

  <div class="ir-ad-slot">广告位</div>

  <AiQuiz lang="zh" />

  <div class="ir-ad-slot">广告位</div>

  <!-- CONTENT CARDS -->
  <section class="ir-section">
    <div class="ir-container">
      <h2 class="ir-section-title">探索 <span class="ir-gradient-text">AI 话题</span></h2>
      <p class="ir-section-sub">深入报道当今人工智能最关键的议题。</p>

      <div class="ir-grid">
        <article class="ir-card">
          <div class="ir-card-icon">&#129504;</div>
          <h3>AI 权利与人格</h3>
          <p>随着AI系统日趋复杂，关于AI权利和法律人格的辩论愈发激烈。探索塑造机器意识未来的哲学和法律框架。</p>
          <div class="ir-card-tag">伦理</div>
        </article>
        <article class="ir-card">
          <div class="ir-card-icon">&#9878;&#65039;</div>
          <h3>AI 监管与治理</h3>
          <p>欧盟AI法案、美国行政命令和全球监管框架正在定义AI的治理方式。了解最新的合规要求和政策发展。</p>
          <div class="ir-card-tag">政策</div>
        </article>
        <article class="ir-card">
          <div class="ir-card-icon">&#128737;&#65039;</div>
          <h3>AI 安全与对齐</h3>
          <p>AI对齐、安全协议和存在风险缓解的研究正在快速推进。了解使AI系统安全且有益的最新突破。</p>
          <div class="ir-card-tag">安全</div>
        </article>
        <article class="ir-card">
          <div class="ir-card-icon">&#10024;</div>
          <h3>生成式 AI 趋势</h3>
          <p>从大语言模型到图像和视频生成，生成式AI正在变革各行各业。最新模型、能力和伦理影响分析。</p>
          <div class="ir-card-tag">生成式AI</div>
        </article>
        <article class="ir-card">
          <div class="ir-card-icon">&#128300;</div>
          <h3>机器学习创新</h3>
          <p>深度学习、强化学习和神经架构的突破正在突破AI所能达到的边界。重要研究论文和行业应用。</p>
          <div class="ir-card-tag">研究</div>
        </article>
        <article class="ir-card">
          <div class="ir-card-icon">&#127970;</div>
          <h3>AI 在商业与社会</h3>
          <p>企业如何在医疗、金融、教育等领域采用AI。影响分析、劳动力转型和负责任的AI部署策略。</p>
          <div class="ir-card-tag">行业</div>
        </article>
      </div>
    </div>
  </section>

  <div class="ir-ad-slot">广告位</div>

  <WeeklyNews lang="zh" />

  <div class="ir-ad-slot">广告位</div>
</BaseLayout>

<style>
  :root {
    --ir-bg: #08090d;
    --ir-surface: rgba(255,255,255,.03);
    --ir-border: rgba(255,255,255,.06);
    --ir-text: rgba(255,255,255,.85);
    --ir-muted: rgba(255,255,255,.5);
    --ir-blue: #3b82f6;
    --ir-violet: #8b5cf6;
    --ir-teal: #06b6d4;
  }

  .ir-hero {
    position: relative; min-height: 100vh; display: flex; align-items: center;
    overflow: hidden; font-family: 'Inter', sans-serif; color: #fff;
  }
  .ir-hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(800px 500px at 30% 20%, rgba(59,130,246,.14), transparent 60%),
      radial-gradient(600px 400px at 70% 60%, rgba(139,92,246,.12), transparent 60%),
      radial-gradient(500px 300px at 50% 90%, rgba(6,182,212,.08), transparent 50%),
      var(--ir-bg);
    animation: heroShift 12s ease-in-out infinite alternate;
  }
  @keyframes heroShift {
    0% { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(15deg); }
  }
  .ir-hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 30%, transparent 100%);
  }
  .ir-hero-content {
    position: relative; max-width: 1140px; margin: 0 auto; padding: 60px 20px;
  }
  .ir-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(59,130,246,.08); border: 1px solid rgba(59,130,246,.2);
    border-radius: 999px; padding: 8px 16px; font-size: .8rem;
    color: var(--ir-blue); margin-bottom: 24px; font-weight: 600;
    letter-spacing: .04em; text-transform: uppercase;
  }
  .ir-pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--ir-blue);
    box-shadow: 0 0 0 3px rgba(59,130,246,.2); animation: irPulse 2s ease-in-out infinite;
  }
  @keyframes irPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(59,130,246,.2); }
    50% { box-shadow: 0 0 0 8px rgba(59,130,246,.05); }
  }
  .ir-title {
    font-size: 3.5rem; font-weight: 800; line-height: 1.1; margin-bottom: 20px;
    font-family: 'Inter', sans-serif; letter-spacing: -.02em;
  }
  @media(max-width:640px) { .ir-title { font-size: 2.2rem; } }
  .ir-gradient-text {
    background: linear-gradient(135deg, var(--ir-blue), var(--ir-violet));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .ir-lead {
    font-size: 1.15rem; color: var(--ir-muted); max-width: 50ch; line-height: 1.7; margin-bottom: 32px;
  }
  .ir-hero-stats { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
  .ir-stat { text-align: center; }
  .ir-stat-value { display: block; font-size: 1.8rem; font-weight: 800; color: #fff; }
  .ir-stat-label { font-size: .75rem; color: var(--ir-muted); text-transform: uppercase; letter-spacing: .06em; }
  .ir-stat-divider { width: 1px; height: 40px; background: var(--ir-border); }

  .ir-section {
    background: var(--ir-bg); padding: 80px 0; font-family: 'Inter', sans-serif; color: #fff;
  }
  .ir-container { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
  .ir-section-title { font-size: 2rem; font-weight: 700; margin-bottom: 8px; }
  .ir-section-sub { color: var(--ir-muted); margin-bottom: 40px; font-size: 1.05rem; }

  .ir-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media(max-width:900px) { .ir-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:600px) { .ir-grid { grid-template-columns: 1fr; } }

  .ir-card {
    background: var(--ir-surface); border: 1px solid var(--ir-border); border-radius: 16px;
    padding: 28px; transition: all .3s ease; position: relative; overflow: hidden;
  }
  .ir-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--ir-blue), var(--ir-violet)); opacity: 0; transition: opacity .3s;
  }
  .ir-card:hover {
    border-color: rgba(59,130,246,.2); transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,.4);
  }
  .ir-card:hover::before { opacity: 1; }
  .ir-card-icon {
    font-size: 2rem; margin-bottom: 16px; width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(59,130,246,.06); border: 1px solid rgba(59,130,246,.1); border-radius: 14px;
  }
  .ir-card h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 10px; color: #fff; }
  .ir-card p { color: var(--ir-muted); font-size: .9rem; line-height: 1.6; margin-bottom: 16px; }
  .ir-card-tag {
    display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: var(--ir-blue); background: rgba(59,130,246,.08);
    border: 1px solid rgba(59,130,246,.15); padding: 4px 10px; border-radius: 6px;
  }

  .ir-ad-slot {
    background: rgba(255,255,255,.02); border: 1px dashed rgba(255,255,255,.06);
    padding: 20px; text-align: center; margin: 0; min-height: 90px;
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,.15); font-size: .8rem; font-family: 'Inter', sans-serif;
  }
</style>
